meta {
  name: logout
  type: http
  seq: 5
}

post {
  url: {{base_url}}/rest-auth/logout/
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessTokenStudent}}
}

settings {
  encodeUrl: true
}

docs {
  ## API explanation
  dj-rest-auth logout. With `JWT_AUTH_HTTPONLY = False` the frontend holds the
  tokens, so the practical step is discarding them client-side; posting the
  refresh token here blacklists it (`rest_framework_simplejwt.token_blacklist`
  is installed).

  ## API example response
  {
    "detail": "Successfully logged out."
  }
}
