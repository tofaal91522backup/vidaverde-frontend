meta {
  name: reset password
  type: http
  seq: 2
}

post {
  url: {{base_url}}/rest-auth/password/reset/confirm/
  body: json
  auth: none
}

body:json {
  {
    // New password. Required. Must pass Django's AUTH_PASSWORD_VALIDATORS.
    "new_password1": "nuevaClave2026",

    // Must match new_password1 exactly. Required.
    "new_password2": "nuevaClave2026",

    // Base64 user id from the reset link. Required.
    // The emailed URL is {{frontend_url}}/auth/password/reset/confirm/<uid>/<token>
    "uid": "NA",

    // Single-use reset token from the same link. Required.
    "token": "cs1234-a0b1c2d3e4f5a6b7c8d9e0f1a2b3c4d5"
  }
}

settings {
  encodeUrl: true
}

docs {
  ## API explanation
  Completes the reset. Both `uid` and `token` come from the link in the reset
  email. The token is single-use and expires.

  ## API example response
  {
    "detail": "Password has been reset with the new password."
  }
}
