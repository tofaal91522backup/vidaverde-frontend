meta {
  name: password change
  type: http
  seq: 3
}

post {
  url: {{base_url}}/rest-auth/password/change/
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessTokenStudent}}
}

body:json {
  {
    // Current password. Required -- checked against the stored hash.
    "old_password": "student123",

    // New password. Required. Must satisfy Django's AUTH_PASSWORD_VALIDATORS:
    // not too similar to the username/email, at least 8 characters,
    // not a common password, not entirely numeric.
    "new_password1": "nuevaClave2026",

    // Must match new_password1 exactly. Required.
    "new_password2": "nuevaClave2026"
  }
}

settings {
  encodeUrl: true
}

docs {
  ## API explanation
  Changes the password of the authenticated user. Any role can call it; a
  student who was auto-created at checkout uses this to replace the generated
  password that was emailed to them.

  When the caller is an admin, the `Admin.password_txt` mirror is updated in the
  same request so it does not drift out of date.

  ## API example response
  {
    "success": true,
    "detail": "Password has been changed successfully."
  }

  ## Changelog
  - 2026-09-05: Switched to a bearer auth block (was a raw `Authorization: {{token}}` header pointing at an undefined variable). Response now includes `success`.
}
