meta {
  name: admins
  type: http
  seq: 2
}

get {
  url: {{base_url}}/administrator/admins/
  body: none
  auth: inherit
}

docs {
  ## API explanation
  **Master admin only.** Every staff account, active and deactivated. Not
  paginated -- a school has a handful of staff.

  `password_txt` is a live credential stored in clear text (it is on the ERD).
  It is returned only here, and only to a master admin. Do not surface it
  anywhere else, and treat any dump of this response as a secret.

  ## API example response
  {
    "success": true,
    "results": [
      {
        "id": "0a2f1c9e-6d51-4a37-bb84-4a1f0d2c8e77",
        "email": "master@vidaverde.test",
        "name": "Rosa Herrera",
        "role": "master",
        "password_txt": "vidaverde123",
        "active": true,
        "created_at": "2026-09-05T08:44:12.000000-05:00",
        "updated_at": "2026-09-05T08:44:12.000000-05:00"
      }
    ]
  }
}
