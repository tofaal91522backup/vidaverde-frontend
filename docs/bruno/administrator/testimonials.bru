meta {
  name: testimonials
  type: http
  seq: 33
}

get {
  url: {{base_url}}/administrator/testimonials/
  body: none
  auth: inherit
}

docs {
  ## API explanation
  Every testimonial, inactive ones included. Not paginated. Ordered by
  `sort_order`, which is also the public order.

  ## API example response
