meta {
  name: update time off
  type: http
  seq: 16
}

patch {
  url: {{base_url}}/administrator/time-off/:id/
  body: json
  auth: inherit
}

params:path {
  id: c4e8a1b7-2d95-4f30-8a16-9b7c3e5d2f48
}

body:json {
  {
    // Optional, ISO-8601 with offset.
    "end_datetime": "2026-12-29T00:00:00-05:00",

    // Optional label shown in the admin list.
    "reason": "Christmas holidays (shortened)"
  }
}

docs {
  ## API explanation
  Edits a blackout window. The end must stay after the start -- otherwise 400.

  Shortening a window makes those slots bookable again immediately.

  ## API example response
  {
    "id": "c4e8a1b7-2d95-4f30-8a16-9b7c3e5d2f48",
    "teacher": "1e54776b-9910-4742-9f8c-8efd23912d4a",
    "start_datetime": "2026-12-24T00:00:00-05:00",
    "end_datetime": "2026-12-29T00:00:00-05:00",
    "reason": "Christmas holidays (shortened)",
    "created_at": "2026-09-05T09:20:00.000000-05:00"
  }
}
