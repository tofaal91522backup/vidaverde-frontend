meta {
  name: blogs
  type: http
  seq: 27
}

get {
  url: {{base_url}}/administrator/blogs/?p=1
  body: none
  auth: inherit
}

params:query {
  p: 1
  ~status: draft
  ~category: school_news
}

docs {
  ## API explanation
  Every post, **drafts included** -- the difference from `GET /public/blogs/`.
  Paginated (`p`, `page_size`).

  Filters: `status` (`draft` / `published`), `category`.

  ## API example response
  {
    "count": 3,
    "page_size": 10,
    "next": null,
    "previous": null,
    "num_pages": 1,
    "current_page": 1,
    "results": [
