meta {
  name: students
  type: http
  seq: 19
}

get {
  url: {{base_url}}/administrator/students/?p=1
  body: none
  auth: inherit
}

params:query {
  p: 1
  ~search: marco
}

docs {
  ## API explanation
  Enrolled students, paginated (`p`, `page_size`). `search` matches name or
  email. Read-only -- admins do not edit student profiles.

  Includes students created by a guest checkout as well as those who registered
  themselves; there is no flag distinguishing them, because they are the same
  thing once created.

  ## API example response
  {
    "count": 2,
    "page_size": 10,
    "next": null,
    "previous": null,
    "num_pages": 1,
    "current_page": 1,
    "results": [
      {
        "id": "2173edc2-1430-4f3e-afd7-5ad8d2e073b3",
        "email": "marco.reyes@example.com",
        "name": "Marco Reyes",
        "profile_img_url": "",
        "country": "Germany",
        "phone_number": "",
        "timezone": "Europe/Berlin",
        "current_spanish_level": "beginner",
        "active": true,
        "created_at": "2026-09-05T03:44:52.700000-05:00",
        "updated_at": "2026-09-05T03:44:52.700000-05:00"
      }
    ]
  }
}
