meta {
  name: students
  type: http
  seq: 8
}

get {
  url: {{base_url}}/administrator/students/?search=marco&p=1
  body: none
  auth: inherit
}

params:query {
  search: marco
  p: 1
}

docs {
  ## API explanation
  Enrolled students, paginated. `search` matches name or email.

  `GET /administrator/students/<id>/` returns the full picture for one student --
  profile, every package they bought, and every class they have had or are
  booked into. Read-only: admins do not edit student profiles.

  ## API example response
  {
    "count": 1,
    "page_size": 10,
    "next": null,
    "previous": null,
    "num_pages": 1,
    "current_page": 1,
    "results": [
      {
        "id": "2173edc2-1430-4f3e-afd7-5ad8d2e073b3",
        "email": "marco.reyes@example.com",
        "name": "Marco Reyes",
        "profile_img_url": "",
        "country": "Germany",
        "phone_number": "",
        "timezone": "Europe/Berlin",
        "current_spanish_level": "beginner",
        "active": true,
        "created_at": "2026-09-05T03:44:52.700000-05:00",
        "updated_at": "2026-09-05T03:44:52.700000-05:00"
      }
    ]
  }
}
