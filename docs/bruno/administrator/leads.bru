meta {
  name: leads
  type: http
  seq: 14
}

get {
  url: {{base_url}}/administrator/leads/?subscribed=true&p=1
  body: none
  auth: inherit
}

params:query {
  subscribed: true
  p: 1
  ~converted: true
  ~search: tess
}

docs {
  ## API explanation
  Everyone who downloaded the free guide, paginated. Read-only.

  - `subscribed=true` -- only those who have not unsubscribed
  - `converted=true` -- only those who went on to book (stamped automatically when their email completes a checkout)
  - `search` -- substring of the email

  `nurture_stage` is how far the queued sequence got: 4 means all three follow-ups
  were scheduled.

  `GET /administrator/leads/export/` downloads the same list as CSV.

  ## API example response
  {
    "count": 2,
    "page_size": 10,
    "next": null,
    "previous": null,
    "num_pages": 1,
    "current_page": 1,
    "results": [
      {
        "id": "027dfbfa-8190-4d3b-8079-81d3be9fd24e",
        "first_name": "Tess",
        "email": "tess@example.com",
        "gdpr_consent": true,
        "source": "homepage",
        "guide_sent_at": "2026-09-05T04:02:11.000000-05:00",
        "nurture_stage": 4,
        "is_subscribed": true,
        "unsubscribed_at": null,
        "converted_at": null,
        "created_at": "2026-09-05T04:02:11.000000-05:00"
      }
    ]
  }
}
