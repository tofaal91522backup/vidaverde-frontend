meta {
  name: teacher time off
  type: http
  seq: 13
}

get {
  url: {{base_url}}/administrator/teachers/:id/time-off/
  body: none
  auth: inherit
}

params:path {
  id: 1e54776b-9910-4742-9f8c-8efd23912d4a
}

docs {
  ## API explanation
  One teacher's blackout windows. `POST` to the same URL adds one -- see
  **create time off**.

  These override the weekly availability: any slot overlapping a window vanishes
  from the public slot endpoints and is refused at booking time.

  ## API example response
  {
    "success": true,
    "results": [
      {
        "id": "c4e8a1b7-2d95-4f30-8a16-9b7c3e5d2f48",
        "teacher": "1e54776b-9910-4742-9f8c-8efd23912d4a",
        "start_datetime": "2026-12-24T00:00:00-05:00",
        "end_datetime": "2027-01-02T00:00:00-05:00",
        "reason": "Christmas holidays",
        "created_at": "2026-09-05T09:20:00.000000-05:00"
      }
    ]
