meta {
  name: packages
  type: http
  seq: 21
}

get {
  url: {{base_url}}/administrator/packages/
  body: none
  auth: inherit
}

docs {
  ## API explanation
  Every package, **including inactive ones** -- that is the difference from
  `GET /public/packages/`. Not paginated.

  `teachers` is the list of teacher UUIDs the package is limited to; empty means
  unrestricted (every active teacher). `teacher_names` echoes them back for
  display.

  ## API example response
  [
    {
      "id": "2da599cd-ed31-4aa1-b919-0828e1f2e2e9",
      "title_en": "Spanish Assessment & First Lesson",
      "title_es": "",
      "description_en": "A 60-minute session...",
      "description_es": "",
      "image_url": "",
      "total_classes": 1,
      "validity_days": 90,
      "price": "12.00",
      "is_first_lesson": true,
      "sort_order": 0,
      "active": true,
      "teachers": [],
      "teacher_names": [],
      "title": "Spanish Assessment & First Lesson",
      "description": "A 60-minute session...",
      "lang": "en",
      "created_at": "2026-09-05T08:44:12.000000-05:00",
      "updated_at": "2026-09-05T08:44:12.000000-05:00"
    }
  ]
}
