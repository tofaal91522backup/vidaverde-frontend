meta {
  name: teachers
  type: http
  seq: 7
}

get {
  url: {{base_url}}/administrator/teachers/?active=true
  body: none
  auth: inherit
}

params:query {
  active: true
  ~search: fernando
}

docs {
  ## API explanation
  Every teacher, with their `time_off` entries embedded. Not paginated.

  Filters: `search` (name or institute), `active` (`true` / `false`).

  Unlike `GET /public/teachers/`, this includes deactivated teachers and exposes
  `google_calendar_id` and `meet_link`.

  ## API example response
  {
    "success": true,
    "results": [
      {
        "id": "1e54776b-9910-4742-9f8c-8efd23912d4a",
        "name": "Fernando Cordero",
        "profile_img_url": "",
        "tags": ["beginners", "conversation", "travel spanish"],
        "institute": "Universidad Central del Ecuador",
        "description_en": "I have taught Spanish for twelve years...",
        "description_es": "",
        "availability": [{ "day": "mon", "start": "08:00", "end": "16:00" }],
        "accepting_students": true,
        "google_calendar_id": "",
        "meet_link": "https://meet.google.com/lookup/vidaverde-demo",
        "active": true,
        "time_off": [],
        "description": "I have taught Spanish for twelve years...",
        "lang": "en",
        "created_at": "2026-09-05T08:44:12.000000-05:00",
        "updated_at": "2026-09-05T08:44:12.000000-05:00"
      }
    ]
  }
}
