meta {
  name: contact messages
  type: http
  seq: 47
}

get {
  url: {{base_url}}/administrator/contact-messages/?handled=false&p=1
  body: none
  auth: inherit
}

params:query {
  handled: false
  p: 1
  ~subject: immersion
}

docs {
  ## API explanation
  Contact form and programme enquiries, newest first, paginated (`p`,
  `page_size`).

  Filters: `handled` (`true` / `false`), `subject` (`online_classes`,
  `immersion`, `homestay`, `travel_spanish`, `other`).

  `?handled=false` is the school's inbox -- `contact_unhandled` on the dashboard
  summary counts exactly this.

  ## API example response
  {
    "count": 1,
    "page_size": 10,
    "next": null,
    "previous": null,
    "num_pages": 1,
    "current_page": 1,
    "results": [
      {
        "id": "b3d91f47-2c8a-4e15-9f60-7a2d1e4c8b93",
        "name": "Julia Brandt",
        "email": "traveller@example.com",
        "subject": "immersion",
        "subject_label": "Immersion Programme",
        "message": "Hello! I am travelling to Ecuador in November...",
        "programme": "",
        "handled": false,
        "handled_at": null,
        "admin_notes": "",
        "created_at": "2026-09-05T08:44:12.000000-05:00"
      }
    ]
  }
}
