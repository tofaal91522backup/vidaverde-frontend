  url: {{base_url}}/administrator/sessions/?filter=upcoming&p=1
  body: none
  auth: inherit
}

params:query {
  filter: upcoming
  p: 1
  ~teacher: 1e54776b-9910-4742-9f8c-8efd23912d4a
  ~status: scheduled
  ~from: 2026-09-01
  ~to: 2026-09-30
}

docs {
  ## API explanation
  "Manage Sessions": upcoming and past classes across the whole school,
  paginated.

  - `filter` -- `upcoming` (soonest first) or `past` (newest first)
  - `teacher` -- UUID
  - `status` -- `scheduled`, `completed`, `no_show`, `cancelled`, `rescheduled`
  - `from` / `to` -- `YYYY-MM-DD`, on the class date

  ## API example response
  {
    "count": 2,
    "page_size": 10,
    "next": null,
    "previous": null,
    "num_pages": 1,
    "current_page": 1,
    "results": [
      {
        "id": "fd36207a-5413-48bc-809e-f5d229d971bb",
        "student_package": "534a4812-5ff0-4ba1-a136-ab610f9c9e21",
        "package_title": "Spanish Assessment & First Lesson",
        "teacher": "1e54776b-9910-4742-9f8c-8efd23912d4a",
        "teacher_name": "Fernando Cordero",
        "student_name": "Marco Reyes",
        "student_email": "marco.reyes@example.com",
        "start_datetime": "2026-09-10T08:00:00-05:00",
        "end_datetime": "2026-09-10T09:00:00-05:00",
        "duration_minutes": 60,
        "status": "scheduled",
        "meet_link": "https://meet.google.com/abc-defg-hij",
        "admin_notes": "",
        "can_reschedule": true,
        "rescheduled_from": null,
        "created_at": "2026-09-05T03:44:52.737000-05:00"
      }
    ]
  }
}
